{
  "name": "sixstack-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve sixstack",
    "build": "ng build sixstack",
    "watch": "ng build sixstack --watch --configuration development",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "tsx projects/components/scripts/build-tokens.ts",
    "tokens:check": "tsc --noEmit -p projects/components/tsconfig.lib.json && tsx projects/components/scripts/build-tokens.ts --check",
    "storybook": "ng run components:storybook",
    "build-storybook": "ng run components:build-storybook",
    "perf-test": "tsx projects/perf-test/scripts/run-perf-test.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "demo": "tsx e2e/demo/scripts/demo.ts",
    "prepare": "cd .. && frontend/node_modules/.bin/husky frontend/.husky || true",
    "e2e:serve": "tsx e2e/support/serve.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/animations": "^22.2.4",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@compodoc/compodoc": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fluentui/tokens": "^1.0.0-alpha.24",
    "@playwright/test": "^1.64.1",
    "@storybook/angular": "^10.6.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "zone.js": "^0.16.3"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,css,json,md,mjs,js}": [
      "prettier --write"
    ]
  }
}
