{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "sixstack": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/sixstack",
      "sourceRoot": "projects/sixstack/src",
      "prefix": "sx",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/sixstack/src/main.ts",
            "tsConfig": "projects/sixstack/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/sixstack/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/geist/index.css",
              "node_modules/@fontsource-variable/geist-mono/index.css",
              "projects/sixstack/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/components/src/lib/styles"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "sixstack:build:production"
            },
            "development": {
              "buildTarget": "sixstack:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/sixstack/proxy.conf.json",
            "port": 4200,
            "allowedHosts": ["host.docker.internal"]
          }
        }
      }
    },
    "api": {
      "projectType": "library",
      "root": "projects/api",
      "sourceRoot": "projects/api/src",
      "prefix": "sx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/api/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/api/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "sx",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "compodoc": false,
            "port": 6006,
            "styles": [
              "node_modules/@fontsource-variable/geist/index.css",
              "node_modules/@fontsource-variable/geist-mono/index.css",
              "projects/components/.storybook/storybook.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/components/src/lib/styles"]
            }
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/components/.storybook",
            "browserTarget": "components:build",
            "compodoc": false,
            "outputDir": "dist/storybook/components",
            "styles": [
              "node_modules/@fontsource-variable/geist/index.css",
              "node_modules/@fontsource-variable/geist-mono/index.css",
              "projects/components/.storybook/storybook.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/components/src/lib/styles"]
            }
          }
        }
      }
    },
    "perf-test": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "projects/perf-test",
      "sourceRoot": "projects/perf-test/src",
      "prefix": "sx",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/perf-test/src/main.ts",
            "tsConfig": "projects/perf-test/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/perf-test/public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/geist/index.css",
              "node_modules/@fontsource-variable/geist-mono/index.css",
              "projects/perf-test/src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["projects/components/src/lib/styles"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "perf-test:build:production"
            },
            "development": {
              "buildTarget": "perf-test:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4300
          }
        }
      }
    }
  }
}
