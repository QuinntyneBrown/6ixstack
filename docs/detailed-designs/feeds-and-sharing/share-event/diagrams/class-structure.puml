@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Share an event

package "SixStack.Domain" {
  enum EventStatus {
    Draft
    InReview
    NeedsChanges
    Rejected
    Published
    Cancelled
  }
  class Event {
    +Guid Id
    +string Slug
    +EventStatus Status
  }
}

package "SixStack.Application" {
  class ResolveShortLinkQuery {
    +string Slug
  }
  class ResolveShortLinkQueryHandler {
    +Handle(query: ResolveShortLinkQuery): Task<ShortLinkTargetDto?>
  }
  class ShortLinkTargetDto {
    +string Path
  }
}

package "SixStack.Api" {
  class ShortLinksController {
    +Resolve(slug: string): Task<IActionResult>
  }
}

package "sixstack (Angular)" {
  class ShareLauncher {
    +share(event: EventDetail): Promise<void>
    -webShareApplies(): boolean
  }
  class ShareEventDialog {
    +data: ShareEventDialogData
    +shortLink: string
    +copied: Signal<boolean>
    +copy(): void
  }
  class ShareEventDialogData {
    +slug: string
    +title: string
    +summaryLine: string
  }
  class ShareLinkBuilder {
    +shortLink(slug: string): string
    +linkedIn(shortLink: string): string
    +bluesky(shortLink: string): string
    +email(title: string, shortLink: string): string
  }
  class ToastService {
    +danger(title: string, text: string, action: ToastAction): void
  }
}

Event --> EventStatus
ShortLinksController ..> ResolveShortLinkQuery : sends
ResolveShortLinkQueryHandler ..> ResolveShortLinkQuery : handles
ResolveShortLinkQueryHandler ..> Event : reads
ResolveShortLinkQueryHandler ..> ShortLinkTargetDto : returns
ShareLauncher ..> ShareEventDialog : CDK Dialog.open
ShareLauncher ..> ShareLinkBuilder
ShareEventDialog --> ShareEventDialogData
ShareEventDialog ..> ShareLinkBuilder
ShareEventDialog ..> ToastService
@enduml
