@startuml
title UML sequence behaviour — Regenerate feeds after an event change
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
participant "Calendar app" as calapp
box "Backend — 6ixstack API application" #D1FADF
  participant "FeedsController" as controller
end box
box "Backend — 6ixstack Application and Domain" #ECFDF3
  participant "Edit, cancel or approve handler" as change
  participant "Event" as entity
  participant "RegenerateFeedsCommandHandler" as regen
end box
box "Backend — 6ixstack Infrastructure" #FFF4E5
  participant "OutboxProcessor" as outbox
  participant "MemoryFeedCache" as cache
  participant "IcsWriter" as writer
  database "6ixstack database" as db
end box
change -> entity : Edit (new start), Cancel or Approve
entity -> entity : Start changed: Sequence += 1 (L2-054); Cancel: Status = Cancelled (L2-056)
change -> db : Save event and FeedRegenerationRequested outbox message in one unit of work
db --> change : Committed; user's action succeeds
outbox -> db : Read due outbox messages
db --> outbox : FeedRegenerationRequested(eventId)
outbox -> regen : Send RegenerateFeedsCommand
regen -> db : Load event
regen -> cache : EvictMatching(event)
cache --> regen : Slugs of cached feeds that include the event
loop each evicted slug
  regen -> db : Query feed events (L2-036)
  regen -> writer : WriteCalendar
  regen -> cache : Set(slug, new snapshot and ETag)
end
alt success
  regen --> outbox : Done
  outbox -> db : Mark message processed
else failure
  regen --> outbox : Exception
  outbox -> db : AttemptCount += 1, NextAttemptAtUtc with exponential backoff, at most 5 attempts (L2-103)
end
calapp -> controller : GET /feeds/{feedSlug}.ics with old ETag
controller --> calapp : 200 with same UID, new start and higher SEQUENCE, or STATUS:CANCELLED (L2-036)
@enduml
