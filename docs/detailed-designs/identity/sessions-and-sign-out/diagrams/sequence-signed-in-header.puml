@startuml
title UML sequence behaviour — Render the signed-in header
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Organizer or moderator" as actor
box "Frontend — 6ixstack web app" #E0F2FE
  participant "SiteHeader" as header
  participant "SessionStore" as store
  participant "HttpAuthApi" as client
end box
box "Backend — 6ixstack API application" #D1FADF
  participant "AuthController" as controller
end box
box "Backend — 6ixstack Application and Domain" #ECFDF3
  participant "GetCurrentUserQueryHandler" as handler
end box
box "Backend — 6ixstack Infrastructure" #FFF4E5
  database "6ixstack database" as db
end box
actor -> header : Open any page
header -> store : user, unreadCount
store -> client : me()
client -> controller : GET /api/auth/me
controller -> handler : Send GetCurrentUserQuery
handler -> db : Load user; count Notifications with ReadAtUtc empty
db --> handler : User and unread count
handler --> controller : CurrentUserDto
controller --> client : 200 JSON
client --> store : CurrentUser
store --> header : Signals updated
alt user is null
  header --> actor : No account controls; Submit event shown
else signed in
  alt unread count above 0
    header --> actor : Button named "Notifications, 3 unread" with badge 3 (L2-050)
  else unread count 0
    header --> actor : Button named "Notifications", no badge (L2-050)
  end
  alt moderator
    header --> actor : Avatar links to /admin/review (L2-050)
  else organizer
    header --> actor : Avatar links to /organize (L2-050)
  end
  opt route data hideSubmit is true
    header --> actor : Submit event button hidden on organizer and moderator pages (L2-050)
  end
end
@enduml
