@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse speakers

Person(visitor, "Visitor", "Anonymous developer browsing events")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Speakers page, toolbar and card grid")
  Container(api, "6ixstack API", "ASP.NET Core", "Public speaker queries")
  ContainerDb(db, "6ixstack database", "SQL Server", "Speakers, talks and events")
}
Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "GET /api/speakers", "JSON/HTTPS")
Rel(api, db, "Reads speakers and next talks", "EF Core")
@enduml
