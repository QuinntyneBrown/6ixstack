@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — View a speaker

Person(visitor, "Visitor", "Anonymous developer browsing events")
System_Ext(mail, "Email client", "Visitor's own mail application")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Speaker page")
  Container(api, "6ixstack API", "ASP.NET Core", "Public speaker query")
  ContainerDb(db, "6ixstack database", "SQL Server", "Speakers, talks, events, community organizers")
}
Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "GET /api/speakers/{slug}", "JSON/HTTPS")
Rel(api, db, "Reads speaker, talks and organizer roles", "EF Core")
Rel(spa, mail, "Opens Invite to speak", "mailto")
@enduml
