@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — View a speaker

Person(visitor, "Visitor", "Anonymous developer browsing events")
System(sixstack, "6ixstack", "Calendar of developer events in Toronto, the GTA and online")
