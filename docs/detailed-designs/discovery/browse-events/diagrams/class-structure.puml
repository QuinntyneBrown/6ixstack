@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Browse upcoming events

package "SixStack.Domain" {
  enum EventStatus {
    Draft
    InReview
    NeedsChanges
    Rejected
    Published
    Cancelled
  }
  enum EventFormat {
    InPerson
    Streaming
    Hybrid
  }
  enum Topic {
    Ai
    DotNet
    Azure
    Angular
    React
    Aws
  }
  class Event {
    +Guid Id
    +string Slug
    +string Title
    +Guid CommunityId
    +EventFormat Format
    +DateTimeOffset StartsAtUtc
    +DateTimeOffset EndsAtUtc
    +string TimeZoneId
    +Venue? Venue
    +Price Price
    +EventStatus Status
    +int GoingCount
    +bool IsSoldOut
    +IsPast(now: DateTimeOffset): bool
  }
  class Venue <<value object>> {
    +string Name
    +string Address
    +string City
  }
  class Price <<value object>> {
    +bool IsFree
    +decimal? AmountCad
  }
}

package "SixStack.Application" {
  class GetUpcomingEventsQuery {
    +FormatFilter Format
    +IReadOnlyList<Topic> Topics
    +string? Search
    +int Page
    +int PageSize
  }
  class GetUpcomingEventsQueryHandler {
    +Handle(query: GetUpcomingEventsQuery): Task<UpcomingEventsDto>
  }
  class UpcomingEventsDto {
    +int Total
    +FormatCountsDto Counts
    +DateOnly RangeEnd
    +IReadOnlyList<DayGroupDto> Days
  }
  class FormatCountsDto {
    +int All
    +int Gta
    +int Streaming
  }
  class DayGroupDto {
    +DateOnly Date
    +IReadOnlyList<EventSummaryDto> Events
  }
  class EventSummaryDto {
    +string Slug
    +string Title
    +string Organizer
    +string StartTimeEt
    +string? SourceTime
    +string LocationLabel
    +EventFormat Format
    +IReadOnlyList<Topic> Topics
    +string PriceLabel
    +int GoingCount
    +bool IsSoldOut
  }
}

package "sixstack (Angular)" {
  class EventsPage {
    +filters: Signal<EventFilters>
    +result: Signal<UpcomingEvents | null>
    +loadMore(): void
    +clearFilters(): void
    +retry(): void
  }
  class FilterStateStore {
    +storageAvailable: boolean
    +read(): EventFilters
    +write(filters: EventFilters): void
  }
  interface EventsApi {
    +getUpcoming(filters: EventFilters, page: number): Observable<UpcomingEvents>
  }
  class HttpEventsApi
}

Event --> EventStatus
Event --> EventFormat
Event "1" --> "1..*" Topic
Event *-- Venue
Event *-- Price
GetUpcomingEventsQueryHandler ..> GetUpcomingEventsQuery : handles
GetUpcomingEventsQueryHandler ..> Event : reads
GetUpcomingEventsQueryHandler ..> UpcomingEventsDto : returns
UpcomingEventsDto *-- FormatCountsDto
UpcomingEventsDto "1" *-- "*" DayGroupDto
DayGroupDto "1" *-- "*" EventSummaryDto
HttpEventsApi ..|> EventsApi
EventsPage ..> EventsApi : EVENTS_API
EventsPage ..> FilterStateStore
@enduml
