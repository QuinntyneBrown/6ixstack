@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Browse upcoming events

Person(visitor, "Visitor", "Anonymous developer browsing events")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Events page, filters, search and day-grouped list")
  Container(api, "6ixstack API", "ASP.NET Core", "Public event queries")
  ContainerDb(db, "6ixstack database", "SQL Server", "Events and communities")
}
Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "GET /api/events", "JSON/HTTPS")
Rel(api, db, "Reads published events", "EF Core")
@enduml
