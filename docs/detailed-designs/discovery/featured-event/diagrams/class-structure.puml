@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Featured event

package "SixStack.Domain" {
  enum EventStatus {
    Draft
    InReview
    NeedsChanges
    Rejected
    Published
    Cancelled
  }
  class FeaturedEvent {
    +DateOnly WeekStartDate
    +Guid EventId
  }
  class Event {
    +Guid Id
    +string Slug
    +string Title
    +string Description
    +Guid CommunityId
    +EventFormat Format
    +DateTimeOffset StartsAtUtc
    +Venue? Venue
    +Price Price
    +string? TicketUrl
    +EventStatus Status
  }
}

package "SixStack.Application" {
  interface IClock {
    +UtcNow: DateTimeOffset
    +TorontoToday: DateOnly
  }
  class GetFeaturedEventQuery
  class GetFeaturedEventQueryHandler {
    +Handle(query: GetFeaturedEventQuery): Task<FeaturedEventDto?>
    -WeekStartFor(today: DateOnly): DateOnly
  }
  class FeaturedEventDto {
    +string Slug
    +string Title
    +string Organizer
    +string Description
    +string MonthLabel
    +int DayOfMonth
    +string LocationLabel
    +bool HasLivestream
    +string WhenLabel
    +ActionLinkDto PrimaryAction
  }
  class ActionLinkDto {
    +string Label
    +string Url
  }
}

package "api (Angular)" {
  interface EventsApi {
    +getFeatured(): Observable<FeaturedEvent | null>
  }
  class HttpEventsApi
}

package "sixstack (Angular)" {
  class EventsPage {
    +featured: Signal<FeaturedEvent | null | undefined>
  }
}

package "components (Angular)" {
  class FeatureCard {
    +event: InputSignal<FeaturedEvent | null>
  }
  class DateTile {
    +month: InputSignal<string>
    +day: InputSignal<number>
  }
}

FeaturedEvent "0..1" --> "1" Event : features
Event --> EventStatus
GetFeaturedEventQueryHandler ..> GetFeaturedEventQuery : handles
GetFeaturedEventQueryHandler ..> IClock : reads Toronto date
GetFeaturedEventQueryHandler ..> FeaturedEvent : reads
GetFeaturedEventQueryHandler ..> Event : reads
GetFeaturedEventQueryHandler ..> FeaturedEventDto : returns
FeaturedEventDto *-- ActionLinkDto
HttpEventsApi ..|> EventsApi
EventsPage ..> EventsApi : EVENTS_API
EventsPage ..> FeatureCard : renders
FeatureCard *-- DateTile
@enduml
