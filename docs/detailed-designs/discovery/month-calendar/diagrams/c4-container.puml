@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Month calendar

Person(visitor, "Visitor", "Anonymous developer browsing events")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Calendar page, month grid, filters, navigation")
  Container(api, "6ixstack API", "ASP.NET Core", "Public event queries")
  ContainerDb(db, "6ixstack database", "SQL Server", "Events")
}
Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "GET /api/events/calendar", "JSON/HTTPS")
Rel(api, db, "Reads published events for the month", "EF Core")
@enduml
