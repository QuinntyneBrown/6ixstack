@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit an event

package "SixStack.Domain" {
  enum EventStatus {
    Draft
    InReview
    NeedsChanges
    Rejected
    Published
    Cancelled
  }
  class Event {
    +Guid Id
    +string Slug
    +string Title
    +Guid CommunityId
    +EventFormat Format
    +DateTimeOffset StartsAtUtc
    +DateTimeOffset EndsAtUtc
    +string TimeZoneId
    +Venue? Venue
    +string? StreamUrl
    +Price Price
    +string? TicketUrl
    +EventStatus Status
    +int GoingCount
    +DateTimeOffset SubmittedAtUtc
    +int Sequence
    +DateTimeOffset? TimeChangedAtUtc
    +DateTimeOffset? LastEditedAtUtc
    +byte[] RowVersion
    +Edit(details: EventDetails, now: DateTimeOffset): EditOutcome
    +Resubmit(): void
    +IsPast(now: DateTimeOffset): bool
  }
  class EventDetails <<value object>> {
    +string Title
    +string Description
    +IReadOnlyList<Topic> Topics
    +EventFormat Format
    +DateTimeOffset StartsAtUtc
    +DateTimeOffset EndsAtUtc
    +string TimeZoneId
    +Venue? Venue
    +string? StreamUrl
    +Price Price
    +string? TicketUrl
  }
  class EditOutcome <<value object>> {
    +IReadOnlyList<string> ChangedFields
    +bool TimeChanged
  }
  class EventReadOnlyException
  class CommunityOrganizer {
    +Guid CommunityId
    +Guid UserId
  }
}

package "SixStack.Application" {
  class GetOrganizerEventQuery {
    +Guid EventId
  }
  class GetOrganizerEventQueryHandler {
    +Handle(query: GetOrganizerEventQuery): Task<Result<EventEditDto>>
  }
  class UpdateOrganizerEventCommand {
    +Guid EventId
    +EventDetailsDto Details
  }
  class UpdateOrganizerEventCommandValidator
  class EventDetailsValidator
  class UpdateOrganizerEventCommandHandler {
    +Handle(command: UpdateOrganizerEventCommand): Task<Result<EventSavedDto>>
  }
  class EventAccessChecker {
    +Check(event: Event): Task<AccessResult>
  }
  class ForbiddenEventAccess {
    +string CommunityName
    +string EventTitle
    +string SignedInEmail
  }
  class EventEditDto {
    +Guid Id
    +string Slug
    +EventDetailsDto Details
    +EventStatus Status
    +int GoingCount
    +DateTimeOffset? LastEditedAtUtc
    +bool IsReadOnly
  }
  class EventSavedDto {
    +EventStatus Status
    +int GoingCount
    +int MatchingFeedCount
    +string PublicUrl
  }
  interface IAuditLog {
    +Record(actorId: Guid, action: string, targetId: Guid, details: object): void
  }
  interface ISubmissionCheckScheduler {
    +Schedule(eventId: Guid): void
  }
  interface IFeedMatchCounter {
    +Count(event: Event): Task<int>
  }
}

package "sixstack (Angular)" {
  class EditEventPage {
    +event: Signal<EventEdit | null>
    +saving: Signal<boolean>
    +errors: Signal<FieldError[]>
    +save(): void
    +discard(): void
    +duplicate(): void
    +openCancel(): void
    +retry(): void
  }
  class EventForm {
    +value: ModelSignal<EventDetails>
    +disabled: InputSignal<boolean>
    +includeContactEmail: InputSignal<boolean>
  }
  class DraftStore {
    +write(draft: EventDetails): void
  }
  interface OrganizerEventsApi {
    +getEvent(id: string): Observable<EventEdit>
    +updateEvent(id: string, details: EventDetails): Observable<EventSaved>
  }
  class HttpOrganizerEventsApi
}

Event --> EventStatus
Event ..> EventDetails : applies
Event ..> EditOutcome : returns
Event ..> EventReadOnlyException : throws
GetOrganizerEventQueryHandler ..> GetOrganizerEventQuery : handles
GetOrganizerEventQueryHandler ..> EventAccessChecker
GetOrganizerEventQueryHandler ..> EventEditDto : returns
UpdateOrganizerEventCommandHandler ..> UpdateOrganizerEventCommand : handles
UpdateOrganizerEventCommandValidator ..> EventDetailsValidator : includes
UpdateOrganizerEventCommandHandler ..> EventAccessChecker
UpdateOrganizerEventCommandHandler --> Event : loads / mutates
UpdateOrganizerEventCommandHandler ..> IAuditLog
UpdateOrganizerEventCommandHandler ..> ISubmissionCheckScheduler
UpdateOrganizerEventCommandHandler ..> IFeedMatchCounter
UpdateOrganizerEventCommandHandler ..> EventSavedDto : returns
EventAccessChecker ..> CommunityOrganizer : reads
EventAccessChecker ..> ForbiddenEventAccess : returns on failure
HttpOrganizerEventsApi ..|> OrganizerEventsApi
EditEventPage ..> OrganizerEventsApi : ORGANIZER_EVENTS_API
EditEventPage *-- EventForm
EditEventPage ..> DraftStore
@enduml
