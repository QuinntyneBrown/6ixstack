@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Organizer dashboard

package "SixStack.Domain" {
  enum EventStatus {
    Draft
    InReview
    NeedsChanges
    Rejected
    Published
    Cancelled
  }
  class Event {
    +Guid Id
    +string Slug
    +string Title
    +Guid CommunityId
    +DateTimeOffset StartsAtUtc
    +DateTimeOffset EndsAtUtc
    +EventStatus Status
    +int GoingCount
    +DateTimeOffset SubmittedAtUtc
    +IsPast(now: DateTimeOffset): bool
  }
  class ModerationDecision {
    +Guid Id
    +Guid EventId
    +Guid ModeratorId
    +DecisionKind DecisionKind
    +RejectionReason? RejectionReason
    +string Message
    +DateTimeOffset DecidedAtUtc
    +DateTimeOffset? UndoneAtUtc
  }
  class CommunityOrganizer {
    +Guid CommunityId
    +Guid UserId
    +string Role
  }
  class User {
    +Guid Id
    +string Email
    +string Name
    +DateTimeOffset? EmailVerifiedAtUtc
  }
  class Community {
    +Guid Id
    +string Name
  }
}

package "SixStack.Application" {
  class GetOrganizerDashboardQuery
  class GetOrganizerDashboardQueryHandler {
    +Handle(query: GetOrganizerDashboardQuery): Task<OrganizerDashboardDto>
  }
  enum DashboardStatus {
    Published
    InReview
    Draft
    NeedsChanges
    Past
    Cancelled
  }
  enum BannerKind {
    InReview
    Live
    NeedsChanges
    NotApproved
    EmailUnverified
  }
  class OrganizerDashboardDto {
    +string CommunityName
    +string Email
    +DashboardStatsDto Stats
    +IReadOnlyList<OrganizerEventRowDto> Events
    +SubmissionBannerDto? Banner
  }
  class DashboardStatsDto {
    +int Upcoming
    +int InReview
    +int Going
    +int FeedSubscribers
  }
  class OrganizerEventRowDto {
    +Guid Id
    +string Title
    +DateTimeOffset StartsAtUtc
    +string DateLabel
    +DashboardStatus Status
    +string StatusLabel
    +int? GoingCount
    +string? NeedsChangesReason
    +string? PublicUrl
    +IReadOnlyList<string> Actions
  }
  class SubmissionBannerDto {
    +string Key
    +BannerKind Kind
    +string EventTitle
    +string? Reason
    +string? ModeratorFirstName
    +int? MatchingFeedCount
    +bool Dismissible
  }
}

package "sixstack (Angular)" {
  class OrganizerDashboardPage {
    +dashboard: Signal<OrganizerDashboard | null>
    +sortDirection: Signal<'ascending' | 'descending'>
    +toggleDateSort(): void
    +dismissBanner(key: string): void
    +retry(): void
  }
  class SubmissionBanner {
    +banner: InputSignal<SubmissionBanner>
    +dismissed: OutputEmitterRef<string>
  }
  class BannerDismissalStore {
    +isDismissed(key: string): boolean
    +dismiss(key: string): void
  }
  interface OrganizerEventsApi {
    +getDashboard(): Observable<OrganizerDashboard>
  }
  class HttpOrganizerEventsApi
}

Event --> EventStatus
GetOrganizerDashboardQueryHandler ..> GetOrganizerDashboardQuery : handles
GetOrganizerDashboardQueryHandler ..> CommunityOrganizer : resolves community
GetOrganizerDashboardQueryHandler ..> Event : reads
GetOrganizerDashboardQueryHandler ..> ModerationDecision : reads
GetOrganizerDashboardQueryHandler ..> User : reads verification
GetOrganizerDashboardQueryHandler ..> OrganizerDashboardDto : returns
CommunityOrganizer --> Community
CommunityOrganizer --> User
ModerationDecision --> Event
OrganizerDashboardDto *-- DashboardStatsDto
OrganizerDashboardDto "1" *-- "*" OrganizerEventRowDto
OrganizerDashboardDto "1" *-- "0..1" SubmissionBannerDto
OrganizerEventRowDto --> DashboardStatus
SubmissionBannerDto --> BannerKind
HttpOrganizerEventsApi ..|> OrganizerEventsApi
OrganizerDashboardPage ..> OrganizerEventsApi : ORGANIZER_EVENTS_API
OrganizerDashboardPage ..> BannerDismissalStore
OrganizerDashboardPage *-- SubmissionBanner
@enduml
