@startuml
title UML sequence behaviour — Load the submit form, keep a draft and switch format
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Visitor" as actor
box "Frontend — 6ixstack web app" #E0F2FE
  participant "SubmitEventPage" as page
  participant "DelayedSkeleton" as sk
  participant "EventFormModel" as form
  participant "DraftStore" as draft
  participant "HttpReferenceDataApi" as client
end box
box "Backend — 6ixstack API application" #D1FADF
  participant "ReferenceDataController" as controller
end box
box "Backend — 6ixstack Application and Domain" #ECFDF3
  participant "GetReferenceDataQueryHandler" as handler
end box
actor -> page : Open /submit
page -> sk : Start 300 ms timer (L2-089)
page -> client : get()
client -> controller : GET /api/reference-data
opt no response within 300 ms
  sk --> page : Show three skeleton sections, aria-busy="true", no inputs (L2-045)
end
controller -> handler : Send GetReferenceDataQuery
handler --> controller : ReferenceDataDto
controller --> client : 200 topics, cities, time zones
client --> page : ReferenceData
page -> form : create() with time zone America/Toronto (L2-041)
page -> draft : read(sx.draft.submit-event)
alt draft present
  draft --> page : Saved values
  page -> form : Patch values (L2-044)
else storage blocked or no draft
  draft --> page : Nothing; available = false when blocked
end
page --> actor : Form in the reserved layout; nothing above it moves (L2-045)
loop each value change
  actor -> page : Type or choose
  page -> draft : write(sx.draft.submit-event, value), debounced (L2-044)
  opt storage blocked
    draft --> page : Write skipped; form keeps working (L2-044)
  end
end
actor -> page : Choose a format
page -> form : applyFormat(format)
alt Streaming
  form --> page : Hide and disable venue name, city, street address (L2-042)
else Hybrid
  form --> page : Show venue name, city, street address and livestream link (L2-042)
else In person
  form --> page : Show venue fields, hide livestream link (L2-042)
end
actor -> page : Choose Free
page -> form : applyPrice(true)
form --> page : Price field disabled (L2-041)
@enduml
