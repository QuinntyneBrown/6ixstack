@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Reject a submission

Person(moderator, "Moderator", "Signed-in 6ixstack volunteer moderator")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Reject submission dialog, review queue")
  Container(api, "6ixstack API", "ASP.NET Core", "Reject endpoint and OutboxProcessor hosted service")
  ContainerDb(db, "6ixstack database", "SQL Server", "Events, decisions, audit entries, outbox")
}
System_Ext(email, "Email provider", "<TO SUPPLY>")
Rel(moderator, spa, "Uses", "HTTPS")
Rel(spa, api, "POST /api/moderation/submissions/{id}/reject", "JSON/HTTPS, session cookie")
Rel(api, db, "Writes event, decision, audit entry and outbox message", "EF Core")
Rel(api, email, "Sends rejection email", "<TO SUPPLY>")
@enduml
