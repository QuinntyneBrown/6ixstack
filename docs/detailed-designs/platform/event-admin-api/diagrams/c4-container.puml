@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Event administration over the API

Person(agent, "Coding agent", "Holds a personal API token")
Person(operator, "Maintainer", "Moderator")
System_Boundary(sixstack, "6ixstack") {
  Container(api, "6ixstack API", "ASP.NET Core on App Service", "api/admin/events behind the ApiToken bearer scheme and AdminApi policy")
  Container(cli, "6ixstack CLI", "SixStack.Cli, .NET console", "tokens and events commands")
  Container(app, "Application layer", "SixStack.Application, MediatR, FluentValidation", "EventAdmin and ApiTokens handlers, validators, audit log")
  Container(infra, "Infrastructure", "SixStack.Infrastructure, EF Core", "AppDbContext, ApiTokenHasher, migrations")
  ContainerDb(db, "6ixstack database", "Azure SQL, SQL Server or SQLite", "Events, users, API tokens, audit entries")
}

Rel(agent, api, "Calls", "HTTPS, Bearer token")
Rel(operator, cli, "Runs tokens create", "Terminal")
Rel(api, app, "Sends queries and commands", "MediatR")
Rel(cli, app, "Sends queries and commands", "MediatR")
Rel(app, infra, "Uses IAppDbContext, IApiTokenHasher, IClock")
Rel(infra, db, "Reads and writes", "EF Core")
@enduml
