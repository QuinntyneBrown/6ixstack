@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Performance budgets

Person(visitor, "Visitor", "Anonymous developer browsing events")
System_Boundary(sixstack, "6ixstack") {
  Container(spa, "6ixstack web app", "Angular, service worker", "Initial JS at most 250 KB gzip; lazy routes; deferred map")
  Container(api, "6ixstack API", "ASP.NET Core", "Projected reads; in-memory feed cache with ETags")
  ContainerDb(db, "6ixstack database", "SQL Server", "Indexed events, communities, speakers")
}
System_Ext(calendars, "Calendar apps", "Google Calendar, Outlook, Apple Calendar")

Rel(visitor, spa, "Uses", "HTTPS")
Rel(spa, api, "Public list p95 <= 300 ms; detail p95 <= 200 ms", "JSON/HTTPS")
Rel(calendars, api, "Cached feed p95 <= 100 ms; 304 when unchanged", "HTTPS")
Rel(api, db, "AsNoTracking projections", "EF Core")
@enduml
